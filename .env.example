# Device selection: "auto", "true", or "false"
# - auto: Automatically detect GPU availability (default)
# - true: Force GPU usage (will fail if GPU not available)
# - false: Force CPU-only mode
USE_GPU=false

# Embedding model for vector search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ollama LLM model name (for local mode)
OLLAMA_MODEL=qwen2.5:3b-instruct

# ============================================================================
# Hybrid LLM Configuration
# ============================================================================

# LLM Mode: "local" or "cloud"
# - local: Uses Ollama with Qwen 2.5 3B (fast, private, requires local Ollama)
# - cloud: Uses Groq API (fast, high-quality, requires GROQ_API_KEY)
LLM_MODE=cloud

# Groq API Key (required for cloud mode)
GROQ_API_KEY=GROQ_API_KEY_HERE
